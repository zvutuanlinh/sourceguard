# Python
__pycache__/
*.pyc
*.pyo

# Notebook temporary
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
*.token
*.secret
credentials*
secrets*

# Temporary / staging
STAGING/
staging/
tmp/
temp/
*.tmp
*.bak

# Review-only renders
**/REVIEW_ONLY/
**/*REVIEW*.png
**/*AUDIT*.png

